        },
        {
          "path": "$EXTENSION_WORK/gradle/*/*/bin/gradle.bat",
          "os": "windows"
        },
        {
          "path": "$EXTENSION_WORK/gradle/*/*/bin/gradle",
          "os": "unix"
        }
      ],
      "fallback": "gradle"
    },
    "tasks": [
      {
        "label": "run",
        "args": [
          "run"
        ],
        "debug": {
          "args": [
            "--debug-jvm"
          ],
          "adapter": "Java",
          "port": 5005,
          "config": {
            "request": "attach",
            "hostName": "localhost",
            "port": 5005
          }
        }
      }
    ],
    "env_file": "$EXTENSION_WORK/env/$ROOT_KEY.env"
  },
  {
    "group": "Gradle",
    "when": {
      "files": [
