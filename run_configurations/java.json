      ]
    },
    "command": {
      "candidates": [
        {
          "path": "$ROOT/gradlew.bat",
          "os": "windows"
        },
        {
          "path": "$ROOT/gradlew",
          "os": "unix"
        },
        {
          "program": "gradle"
        },
        {
          "path": "$EXTENSION_WORK/gradle/*/*/bin/gradle.bat",
          "os": "windows"
        },
        {
          "path": "$EXTENSION_WORK/gradle/*/*/bin/gradle",
          "os": "unix"
