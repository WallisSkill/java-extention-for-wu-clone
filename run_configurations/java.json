    "env_file": "$EXTENSION_WORK/env/$ROOT_KEY.env"
  },
  {
    "group": "Spring Boot",
    "when": {
      "files": [
        "build.gradle.kts",
        "build.gradle"
      ],
      "contains_any": [
        "org.springframework.boot"
      ]
    },
    "command": {
      "candidates": [
        {
          "path": "$ROOT/gradlew.bat",
          "os": "windows"
        },
        {
          "path": "$ROOT/gradlew",
          "os": "unix"
        },
        {
          "program": "gradle"
